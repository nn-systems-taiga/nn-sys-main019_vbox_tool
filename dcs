import os
import queue
import threading
import time
import av
import cv2
import imageio
import mss
import numpy as np
import sounddevice as sd
import soundfile as sf

# ==========================================
# 起動時の統合メニュー（ユーザー負担ゼロ化）
# ==========================================
def select_user_options():
  print("========================================")
  print("         社内用 画面録画ツール          ")
  print("========================================")
  
  # 1. 保存形式の選択
  print("\n[ステップ 1] 保存形式を選択してください")
  print("1 : MP4 動画 (音声あり・社内会議やマニュアル作成向け)")
  print("2 : GIF アニメ (音声なし・チャットツールへの添付向け)")
  print("----------------------------------------")
  while True:
    fmt_choice = input("番号を入力して Enter: ").strip()
    if fmt_choice == "1":
      file_format = "mp4"
      break
    elif fmt_choice == "2":
      file_format = "gif"
      break
    print("無効な入力です。1 または 2 を入力してください。")

  # 2. 画質（解像度）の選択
  print("\n[ステップ 2] 録画画質（解像度）を選択してください")
  print("1 : 1080p (フルHD / 1920 × 1080) ※高画質・文字もクッキリ")
  print("2 : 720p  (HD / 1280 × 720)     ※標準画質・容量を節約")
  print("3 : オリジナル解像度 (現在の画面サイズのまま録画)")
  print("----------------------------------------")
  while True:
    qual_choice = input("番号を入力して Enter: ").strip()
    if qual_choice == "1":
      resolution = (1920, 1080)
      res_label = "1080p"
      break
    elif qual_choice == "2":
      resolution = (1280, 720)
      res_label = "720p"
      break
    elif qual_choice == "3":
      resolution = None
      res_label = "Original"
      break
    print("無効な入力です。1, 2, 3 のいずれかを入力してください。")

  return file_format, resolution, res_label

# ユーザー設定の取得
FORMAT, TARGET_RESOLUTION, RESOLUTION_LABEL = select_user_options()

# 初期設定項目
FPS = 10.0  # フレームレート
OUTPUT_BASE_NAME = "company_recorded_output"
FINAL_OUTPUT_NAME = f"{OUTPUT_BASE_NAME}_{RESOLUTION_LABEL}.{FORMAT}"

# GIFの場合は自動的に音声を無効化
RECORD_SYSTEM_AUDIO = True if FORMAT == "mp4" else False
RECORD_MIC_AUDIO = True if FORMAT == "mp4" else False

# ==========================================
# デバイスの自動検出関数（Windows WASAPI）
# ==========================================
def auto_find_devices():
  sys_id, mic_id = None, None
  devices = sd.query_devices()
  hostapis = sd.query_hostapis()

  for i, dev in enumerate(devices):
    api_name = hostapis[dev["hostApi"]]["name"]
    if api_name == "Windows WASAPI" and dev["maxOutputChannels"] > 0:
      if "loopback" in dev["name"].lower() or dev["maxInputChannels"] > 0:
        sys_id = i
        break
  if sys_id is None:
    for i, dev in enumerate(devices):
      if "ステレオ ミキサー" in dev["name"]:
        sys_id = i
        break

  for i, dev in enumerate(devices):
    if dev["maxInputChannels"] > 0 and "loopback" not in dev["name"].lower():
      if i == sd.default.device:
        mic_id = i
        break
      if mic_id is None:
        mic_id = i

  return sys_id, mic_id

SYSTEM_AUDIO_ID, MIC_AUDIO_ID = auto_find_devices()

# ==========================================
# 内部処理用
# ==========================================
is_recording = True
is_running = True
audio_queue_sys = queue.Queue()
audio_queue_mic = queue.Queue()
SAMPLE_RATE = 44100

TEMP_VIDEO = "temp_raw_video.mp4"
TEMP_SYS_AUDIO = "temp_sys.wav"
TEMP_MIC_AUDIO = "temp_mic.wav"
TEMP_MIX_AUDIO = "temp_mixed_audio.wav"

def audio_callback_sys(indata, frames, time, status):
  if is_recording:
    audio_queue_sys.put(indata.copy())

def audio_callback_mic(indata, frames, time, status):
  if is_recording:
    audio_queue_mic.put(indata.copy())

def key_listener():
  global is_recording, is_running
  while is_running:
    cmd = input().strip().lower()
    if cmd == "p":
      is_recording = not is_recording
      status = "録画中" if is_recording else "一時停止中"
      print(f"\n[ステータス変更] 現在: {status}")
    elif cmd == "q":
      is_running = False
      break

# メイン録画処理
with mss.mss() as sct:
  monitor = sct.monitors

  if TARGET_RESOLUTION is None:
    target_width = monitor["width"]
    target_height = monitor["height"]
  else:
    target_width, target_height = TARGET_RESOLUTION

  video_frames = []
  audio_stream_sys, audio_stream_mic = None, None

  print("\n=== オーディオデバイス自動検出結果 ===")
  if RECORD_SYSTEM_AUDIO and SYSTEM_AUDIO_ID is not None:
    print("・PC内音声: 自動設定完了")
    audio_stream_sys = sd.InputStream(device=SYSTEM_AUDIO_ID, channels=2, samplerate=SAMPLE_RATE, callback=audio_callback_sys)
    audio_stream_sys.start()
    sf_sys = sf.SoundFile(TEMP_SYS_AUDIO, mode="w", samplerate=SAMPLE_RATE, channels=2)

  if RECORD_MIC_AUDIO and MIC_AUDIO_ID is not None:
    print("・マイク音声: 自動設定完了")
    audio_stream_mic = sd.InputStream(device=MIC_AUDIO_ID, channels=1, samplerate=SAMPLE_RATE, callback=audio_callback_mic)
    audio_stream_mic.start()
    sf_mic = sf.SoundFile(TEMP_MIC_AUDIO, mode="w", samplerate=SAMPLE_RATE, channels=1)
    
  if not RECORD_SYSTEM_AUDIO and not RECORD_MIC_AUDIO:
    print("・音声録音: なし (GIF選択または音声OFF)")
  print("===================================\n")

  threading.Thread(target=key_listener, daemon=True).start()

  print(f"=== 録画を開始しました（形式: {FORMAT.upper()} / 画質: {RESOLUTION_LABEL}） ===")
  print(" [操作方法]")
  print("  p + Enter : 一時停止 / 再開")
  print("  q + Enter : 終了してファイル保存処理へ")
  print("==========================================================")

  frame_delay = 1.0 / FPS

  try:
    while is_running:
      start_time = time.time()

      if is_recording:
        sct_img = sct.grab(monitor)
        frame = np.array(sct_img)
        frame = cv2.cvtColor(frame, cv2.COLOR_BGRA2RGB)

        frame = cv2.resize(frame, (target_width, target_height), interpolation=cv2.INTER_AREA)
        video_frames.append(frame)

        if audio_stream_sys:
          while not audio_queue_sys.empty():
            sf_sys.write(audio_queue_sys.get())
        if audio_stream_mic:
          while not audio_queue_mic.empty():
            sf_mic.write(audio_queue_mic.get())
      else:
        while not audio_queue_sys.empty():
          audio_queue_sys.get()
        while not audio_queue_mic.empty():
          audio_queue_mic.get()

      elapsed_time = time.time() - start_time
      if elapsed_time < frame_delay:
        time.sleep(frame_delay - elapsed_time)

  finally:
    is_running = False
    if audio_stream_sys:
      audio_stream_sys.stop()
      sf_sys.close()
    if audio_stream_mic:
      audio_stream_mic.stop()
      sf_mic.close()

  # === 保存・純粋ライブラリ合成処理 ===
  if video_frames:
    print("\n[ファイル書き出し中] データを処理しています。少々お待ちください...")

    if FORMAT == "mp4":
      # 1. まず一時的に無音の動画ファイルを作成
      fourcc = cv2.VideoWriter_fourcc(*"mp4v")
      out = cv2.VideoWriter(TEMP_VIDEO, fourcc, FPS, (target_width, target_height))
      for f in video_frames:
        out.write(cv2.cvtColor(f, cv2.COLOR_RGB2BGR))
      out.release()

      has_sys = RECORD_SYSTEM_AUDIO and os.path.exists(TEMP_SYS_AUDIO)
      has_mic = RECORD_MIC_AUDIO and os.path.exists(TEMP_MIC_AUDIO)

      # 2. 音声が存在する場合のミックス処理
      audio_path = None
      if has_sys or has_mic:
        if has_sys and has_mic:
          data_sys, sr = sf.read(TEMP_SYS_AUDIO)
          data_mic, _ = sf.read(TEMP_MIC_AUDIO)
          if data_mic.ndim == 1:
            data_mic = np.column_stack((data_mic, data_mic))
          min_len = min(len(data_sys), len(data_mic))
          mixed_data = data_sys[:min_len] + data_mic[:min_len]
          sf.write(TEMP_MIX_AUDIO, mixed_data, sr)
          audio_path = TEMP_MIX_AUDIO
        elif has_sys:
          audio_path = TEMP_SYS_AUDIO
        else:
          audio_path = TEMP_MIC_AUDIO

      # 3. PyAV（avライブラリ）を使用して、外部アプリを一切使わずに映像と音声を1つに結合
      if audio_path and os.path.exists(audio_path):
        input_video = av.open(TEMP_VIDEO)
        input_audio = av.open(audio_path)
        output = av.open(FINAL_OUTPUT_NAME, "w")

        # ストリームのコピー設定
        in_video_stream = input_video.streams.video[0]
        out_video_stream = output.add_stream(template=in_video_stream)
        in_audio_stream = input_audio.streams.audio[0]
        out_audio_stream = output.add_stream(template=in_audio_stream)

        # 映像パケットの書き込み
        for packet in input_video.demux(in_video_stream):
          if packet.dts is not None:
            packet.stream = out_video_stream
            output.mux(packet)

        # 音声パケットの書き込み（動画の長さに合わせる）
        video_duration = in_video_stream.duration * in_video_stream.time_base
        for packet in input_audio.demux(in_audio_stream):
          if packet.pts is not None:
            packet_time = packet.pts * in_audio_stream.time_base
            if packet_time > video_duration:
              break
          packet.stream = out_audio_stream
          output.mux(packet)

        input_video.close()
        input_audio.close()
        output.close()
      else:
        # 音声がない場合はそのままリネーム
        if os.path.exists(FINAL_OUTPUT_NAME):
          os.remove(FINAL_OUTPUT_NAME)
        os.rename(TEMP_VIDEO, FINAL_OUTPUT_NAME)

    elif FORMAT == "gif":
      imageio.mimsave(FINAL_OUTPUT_NAME, video_frames, duration=(1000 / FPS), loop=0)

    # 一時ファイルの完全消去（セキュリティ保持）
    for temp_file in [TEMP_VIDEO, TEMP_SYS_AUDIO, TEMP_MIC_AUDIO, TEMP_MIX_AUDIO]:
      if os.path.exists(temp_file):
        try:
          os.remove(temp_file)
        except:
          pass

    print(f"\n=== 保存完了: {os.path.abspath(FINAL_OUTPUT_NAME)} ===")
